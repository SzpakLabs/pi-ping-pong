{
  "name": "pi-ping-pong",
  "version": "0.1.2",
  "description": "Run bounded Pi coding tasks with independent review.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SzpakLabs/pi-ping-pong.git"
  },
  "keywords": [
    "pi-package"
  ],
  "files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "SKILL.md",
    "docs/GUIDE.md",
    "docs/action-scoped-protocol.md",
    "docs/evaluator-preparation.md",
    "docs/headless-reviewer.md",
    "docs/manual-e2e.md",
    "docs/manual-e2e-report-template.md",
    "docs/project-workspace.md",
    "extensions/pi-reviewed.ts",
    "references/reviewed-runs.md",
    "scripts/action_bridge.py",
    "scripts/action_protocol.py",
    "scripts/bridge.py",
    "scripts/headless_reviewer.py",
    "scripts/launch_diff.py",
    "scripts/output_snapshot.py",
    "scripts/ppp_checkpoint.py",
    "scripts/ralph-parent-guard.mjs"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "pi": {
    "extensions": ["./extensions/pi-reviewed.ts"],
    "skills": ["./SKILL.md"]
  },
  "scripts": {
    "lint": "eslint extensions/*.ts scripts/*.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "check:python": "sh scripts/check-python.sh",
    "check:ts": "sh scripts/check-ts.sh",
    "check:bridge": "python3 -B scripts/test_action_bridge.py",
    "check:faults": "python3 -B scripts/test_action_faults.py",
    "check:integration": "sh scripts/check-integration.sh",
    "check": "sh scripts/check.sh"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@eslint/js": "^9.28.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22.15.30",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1"
  }
}
